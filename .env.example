# ---------------------------------------------------------------------------
# prediction-mispricing-engine: environment configuration template.
#
# Copy to `.env` and fill in ONLY the values you need. Every credential below
# is optional. The engine runs fully in demo/paper mode with no credentials:
# it uses stored market snapshots under data/raw/ and never places orders.
#
# No credential here is ever required to run detection, backtesting,
# paper execution, or the dashboard.
# ---------------------------------------------------------------------------

# --- Polymarket ------------------------------------------------------------
# Read-only market data (Gamma + CLOB public endpoints) needs NO credentials.
# These are only needed if you ever enable live order placement, which this
# project does not do: all execution is simulated (paper trading).
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_PASSPHRASE=

# --- Kalshi ----------------------------------------------------------------
# Public market-data endpoints need NO credentials.
# Demo environment (recommended for testing auth without real money):
#   https://external-api.demo.kalshi.co/trade-api/v2
# Production:
#   https://external-api.kalshi.com/trade-api/v2
# KALSHI_ENV=demo
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=~/.kalshi/private.pem

# --- Application -----------------------------------------------------------
# DATABASE_URL=sqlite:///./data/processed/mispricing.db
# LOG_LEVEL=INFO
